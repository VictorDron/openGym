# ─────────────────────────────────────────────────────────────────────────────
# openGym — single-container image for Railway.
#
# Railway routes one public port per service and cannot share a volume between
# services, so the upstream three-service compose stack (media → api → web) is
# folded into one container:
#
#   • nginx serves the built React app and proxies /api → the Node API on
#     127.0.0.1, so the whole app lives on ONE origin — required for WebAuthn.
#   • the Node API runs beside it, its data on the Railway volume at /data.
#   • the ~140 MB exercise media is NOT baked in. The frontend is built with
#     VITE_IMG_BASE/VITE_GIF_BASE aimed at the pinned jsDelivr mirror of the
#     dataset — the same thing the upstream demo/mobile build does, see the
#     comment in frontend/src/lib/exercises.js and the build:mobile script.
# ─────────────────────────────────────────────────────────────────────────────

FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci 2>/dev/null || npm install
COPY frontend/ ./
# Pinned to the same dataset commit the upstream build:mobile script uses, so the
# image/gif filenames the catalogue references always exist at that URL.
ARG DATASET_REF=7455efae41b330c265e7cd4b78dfa848e7ce5ebd
ENV VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@${DATASET_REF}/images/
ENV VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@${DATASET_REF}/videos/
RUN npm run build

FROM node:22-alpine
RUN apk add --no-cache nginx gettext tini

WORKDIR /app
COPY api/package.json api/package-lock.json* ./
RUN npm install --omit=dev && npm cache clean --force
COPY api/server.js ./

COPY --from=build /app/dist /usr/share/nginx/html
COPY railway/nginx.conf.template /etc/nginx/opengym.conf.template
COPY railway/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /run/nginx /data

ENV NODE_ENV=production
ENV DATA_DIR=/data
ENV API_PORT=3000
ENV PORT=8080

EXPOSE 8080
ENTRYPOINT ["/sbin/tini", "--", "/entrypoint.sh"]
